# ============================================================
# AquaQuest Colombia — Variables de Entorno / Credenciales
# ============================================================

# EmailJS (Formulario de Contacto)
# Regístrate gratis en https://www.emailjs.com/
# 1. Crea un Email Service (ej. Gmail) y copia el Service ID
# 2. Crea un Email Template y copia el Template ID
#    Campos esperados en el template:
#      - {{from_name}} : Nombre del remitente
#      - {{reply_to}}  : Correo electrónico del remitente
#      - {{subject}}   : Asunto del mensaje
#      - {{message}}   : Contenido del mensaje
# 3. En Account > General > API Keys copia tu Public Key
EMAILJS_SERVICE_ID=service_aquaquest
EMAILJS_TEMPLATE_ID=template_contacto
EMAILJS_PUBLIC_KEY=tu_public_key_aqui

# Puerto del servidor local (Node.js)
PORT=3000
